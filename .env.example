# Supabase Configuration (get these from your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Delivery Configuration
# Change "Casablanca" to your city for free delivery
NEXT_PUBLIC_FREE_DELIVERY_CITY=Casablanca

# Paid delivery fee in MAD (for other cities)
NEXT_PUBLIC_PAID_DELIVERY_FEE=30
